# Paste into Dokploy's Environment tab. Keep real credentials out of Git.
# Generate a password with: openssl rand -hex 32
AGENT_OFFICE_PASSWORD=

# GitHub access for project selection, cloning, issues, pull requests and pushing.
# Use a token restricted to the repositories the office should access.
GH_TOKEN=
GIT_USER_NAME=
GIT_USER_EMAIL=

# Claude: configure ONE of these, or sign in interactively inside the container.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

AGENT_OFFICE_AGENT=claude
AGENT_OFFICE_MAX_WORKERS=3

# Optional Claude-only tracked spend limit; not a provider billing cap.
AGENT_OFFICE_BUDGET=
AGENT_OFFICE_BUDGET_PAUSE=0
AGENT_OFFICE_CITY=
